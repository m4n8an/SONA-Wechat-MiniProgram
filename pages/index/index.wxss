.page {
  width: 100vw;
  height: 100vh;
  background: #04070b;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}
.stage {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 0 0 2px #16405c, 0 12px 50px rgba(0, 0, 0, 0.7);
}
.screen {
  display: block;
  background: #04070b;
}
.hint {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 10px;
  text-align: center;
  color: #3a5a70;
  font-size: 11px;
  pointer-events: none;
  padding-bottom: env(safe-area-inset-bottom);
}

