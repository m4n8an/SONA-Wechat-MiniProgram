.page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--sona-bg, #04070b);
  overflow: hidden;
}
.stage {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
}
.screen {
  display: block;
  background: var(--sona-bg, #04070b);
}

